# ==============================================================================
# Agent Engine Environment Configuration (spec_engine/.env.example)
# Copy this file to .env when running agent_engine locally:
#   cp spec_engine/.env.example spec_engine/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Model Credentials
# ------------------------------------------------------------------------------
# (Optional) If using Google AI Studio instead of Vertex AI, uncomment:
# GEMINI_API_KEY=your_gemini_api_key_here

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# GCP infrastructure region (Cloud Run, Artifact Registry, Agent Runtime)
GOOGLE_CLOUD_LOCATION=us-east1

# Default Gemini model used across agent subagents
DEFAULT_LLM=gemini-3.6-flash
LLM_LOCATION=global

# Workaround for mTLS/MutualTLSChannelError during agents-cli deploy or API calls
GOOGLE_API_USE_CLIENT_CERTIFICATE=false

# ------------------------------------------------------------------------------
# 2. GitHub Integration Credentials (used by agent tools)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=98765432
GITHUB_REPO=owner/repo

# Path to GitHub App RSA private key PEM file (or pass raw PEM via GITHUB_APP_PRIVATE_KEY)
GITHUB_APP_PRIVATE_KEY_PATH=./path/to/private-key.pem

# ------------------------------------------------------------------------------
# 3. Observability & Telemetry Settings
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# LOGS_BUCKET_NAME=your-gcs-logs-bucket-name
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
