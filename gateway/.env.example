# ==============================================================================
# Gateway Proxy Environment Configuration (gateway/.env.example)
# Copy this file to .env when running gateway locally:
#   cp gateway/.env.example gateway/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Deployment Region
# ------------------------------------------------------------------------------
export GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
export GOOGLE_CLOUD_LOCATION=us-east1

# ------------------------------------------------------------------------------
# 2. Local Agent API / Vertex AI Reasoning Engine Endpoints
# ------------------------------------------------------------------------------
# URL of the local core ADK Agent app (used during local testing)
export AGENT_API_URL=http://localhost:8000

# Deployed Vertex AI Reasoning Engine resource path (required for Cloud Run deployment)
# export REASONING_ENGINE_ID=projects/YOUR_PROJECT_NUMBER/locations/us-east1/reasoningEngines/YOUR_ENGINE_ID

# Deployed Gateway service public HTTPS URL (for webhook callback configuration)
# export CLOUD_RUN_GATEWAY_URL=https://your-gateway-service-xyz.a.run.app

# ------------------------------------------------------------------------------
# 3. Async Execution & Cloud Tasks Queue Routing
# ------------------------------------------------------------------------------
export ENABLE_CLOUD_TASKS=false
export CLOUD_TASKS_QUEUE_ID=github-agent-queue
export CLOUD_TASKS_SERVICE_ACCOUNT=123456789101-compute@developer.gserviceaccount.com

# ------------------------------------------------------------------------------
# 4. GitHub Integration & Webhook Authentication
# ------------------------------------------------------------------------------
# Webhook Secret configured in GitHub App "General" settings
export GITHUB_WEBHOOK_SECRET=my_github_app_webhook_secret_123
