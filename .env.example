# ==============================================================================
# Spec Deliberator Agent & Gateway Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Model Credentials
# ------------------------------------------------------------------------------
export GOOGLE_GENAI_USE_VERTEXAI=true
export GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# GCP infrastructure & deployment region (Cloud Run, Artifact Registry, Pub/Sub, Agent Engine)
export DEFAULT_GOOGLE_CLOUD_LOCATION=us-east1
export GOOGLE_CLOUD_LOCATION="${DEFAULT_GOOGLE_CLOUD_LOCATION}"

# Vertex AI Gemini LLM API location (e.g., global, us-central1, us-east1)
export DEFAULT_LLM_LOCATION=global
export LLM_LOCATION="${DEFAULT_LLM_LOCATION}"

# Workaround for mTLS/MutualTLSChannelError during agents-cli deploy or API calls:
export GOOGLE_API_USE_CLIENT_CERTIFICATE=false

export DEFAULT_LLM=gemini-3.5-flash

# (Optional) If using Google AI Studio instead of Vertex AI, uncomment:
# export GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. GitHub Integration Credentials
# ------------------------------------------------------------------------------
export GITHUB_APP_ID=123456
export GITHUB_APP_INSTALLATION_ID=98765432
export GITHUB_APP_PRIVATE_KEY_PATH=/path/to/spec-deliberator-private-key.pem

# Webhook Secret configured in GitHub App "General" settings
export GITHUB_WEBHOOK_SECRET=my_github_app_webhook_secret_123

# (Optional) Alternatively pass raw PEM string directly instead of file path:
# export GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."

# ------------------------------------------------------------------------------
# 3. Gateway / Proxy Configuration (gateway/)
# ------------------------------------------------------------------------------
# URL of the core ADK Agent app
export AGENT_API_URL=http://localhost:8000

# Set to true when deploying on GCP Cloud Run with Cloud Pub/Sub
export ENABLE_PUBSUB=false
export PUBSUB_TOPIC_ID=github-human-events

# ------------------------------------------------------------------------------
# 4. Optional CORS & Observability Settings
# ------------------------------------------------------------------------------
# export ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
# export LOGS_BUCKET_NAME=your-gcs-logs-bucket-name